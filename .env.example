# Server-side only. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
# Example verified against official docs; no fallback model in code.
OPENAI_MODEL=gpt-5.4-mini

# Optional local result DB path (default shown). Keep DB files private.
SQLITE_PATH=private-data/feature-discovery.sqlite

# Private originals and analysis images (never under public/).
IMAGE_STORAGE_PATH=private-data/images

# Optional OCR Python executable and ASCII-only model cache directory (Windows).
# OCR_PYTHON=C:/path/to/python.exe
# OCR_CACHE_PATH=C:/path/to/ocr-models

# Grounding DINO local inference; existing compatible Python may be reused.
# GROUNDING_PYTHON=C:/path/to/python.exe
# GROUNDING_CACHE_PATH=C:/path/to/grounding-models

# Spring-to-Node inspection API (use the same key in Spring)
NODE_ANALYSIS_API_KEY=
# URL reachable by the frontend; unset returns image.url=null
INSPECTION_PUBLIC_BASE_URL=http://127.0.0.1:3000
