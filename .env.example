# Server-side only. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
# Example verified against official docs; no fallback model in code.
OPENAI_MODEL=gpt-5.4-mini

# Server-to-server key for the Spring analysis adapter. Never expose to a client.
ANALYSIS_API_KEY=

# Optional local OCR/object-detection sidecar; disabled until both values are set.
ANALYSIS_VISION_STAGE_URL=
ANALYSIS_VISION_STAGE_KEY=
GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-tiny
GROUNDING_DINO_REVISION=a2bb814dd30d776dcf7e30523b00659f4f141c71

# Optional local result DB path (default shown). Keep DB files private.
SQLITE_PATH=private-data/feature-discovery.sqlite

# Private originals and analysis images (never under public/).
IMAGE_STORAGE_PATH=private-data/images

# Optional container-only internal host allowlist. Never expose the analysis port publicly.
# ANALYSIS_BIND_HOST=0.0.0.0  # Docker image sets this; local default remains loopback.
ANALYSIS_API_HOSTS=
